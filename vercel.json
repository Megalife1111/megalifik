{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --omit=dev",
  "buildCommand": "npm run vercel-build",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/send_test.php", "destination": "/api/telegram/test" },
    { "source": "/send_homework.php", "destination": "/api/telegram/homework" },
    { "source": "/send_reading.php", "destination": "/api/telegram/reading" },
    { "source": "/send_emotional.php", "destination": "/api/telegram/emotional" },
    { "source": "/send_trainer.php", "destination": "/api/telegram/trainer" },
    { "source": "/send_conformity.php", "destination": "/api/telegram/conformity" },
    { "source": "/send_memory.php", "destination": "/api/telegram/memory" }
  ],
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  }
}