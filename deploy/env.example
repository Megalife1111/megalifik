# Скопируйте в server/.env на сервере: cp deploy/env.example server/.env && nano server/.env

NODE_ENV=production
PORT=3000

# Сгенерируйте: openssl rand -hex 32
SESSION_SECRET=

# Публичный URL с https (без слэша в конце)
LMS_PUBLIC_URL=https://example.com

# Только при первом npm run seed
LMS_ADMIN_EMAIL=admin@example.com
LMS_ADMIN_PASSWORD=

# true — редирект на логин для прямых ссылок /courses/*
# LMS_PROTECT_LEGACY=false

# --- Vercel (Turso вместо локального SQLite) ---
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# --- Telegram (Vercel / Node, вместо PHP) ---
